# ============ 影序 CineFlow 部署配置 ============
# 复制为 .env 后修改，然后执行 docker compose pull && docker compose up -d

# 对外访问端口
CINEFLOW_HTTP_PORT=8080

# 首次启动的管理密码（至少 6 位）。部署后请登录并在「设置 → 安全」里修改。
CINEFLOW_ADMIN_PASSWORD=change-me

# 会话与密钥加密用的主密钥。留空会在 data/secret.key 自动生成。
# 建议设置为随机字符串，例如：openssl rand -hex 32
CINEFLOW_SECRET_KEY=

# 通过 HTTPS 反向代理访问时设为 true，防止 Cookie 在明文连接中传输
CINEFLOW_COOKIE_SECURE=false

# 登录会话有效期（天）
CINEFLOW_SESSION_DAYS=14

# 空数据库启动时自动载入演示数据（无需 TMDb Key 即可体验）
CINEFLOW_DEMO=false

# 可选：TMDb API / 图片地址。服务器无法直连 api.themoviedb.org 时可改用备用 API 入口。
# CINEFLOW_TMDB_API_BASE=https://api.tmdb.org/3
# CINEFLOW_TMDB_IMAGE_BASE=https://image.tmdb.org/t/p

# 宿主机媒体目录，会被挂载到容器内 /media
# 例如：MEDIA_PATH=/Volumes/media 或 /mnt/nas/media
MEDIA_PATH=./media

# 可选：以非 root 用户运行（推荐）。设置为你宿主机上的 UID / GID。
# 留空则默认以 root 运行，以获得最大的文件写入兼容性。
# Linux 下可以用 `id -u` / `id -g` 查看。
PUID=
PGID=

# 时区，影响任务时间显示
TZ=Asia/Shanghai
